# Dependencies
node_modules/

# Build output — REQ-STACK-02 is verified on the assumption this is not in git
dist/
# The Prisma client. Prisma 7 generates it as TypeScript into the source tree rather than into
# node_modules; it is build output all the same, reproduced by `prisma generate` from
# prisma/schema.prisma, which is the file under review.
src/generated/
build/
*.tsbuildinfo

# Environment — the database credentials live here, and point at the deployed database.
# .env.example is committed on purpose; it lists the variables without their values.
.env
.env.*
!.env.example

# Tests and logs
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Working notes for the agent workflow — design specs and implementation plans written while a
# milestone is in progress. They are scaffolding, not deliverables: AGENTS.md places the decisions
# in docs/requirements/REQUIREMENTS.md, and a second place describing the same choices is what
# REQ-EVAL-01 counts against.
docs/superpowers/

# Editors and OS
.DS_Store
.idea/
*.swp

# NOTE: prisma/migrations/ is NOT ignored. The migration files are generated, but they are
# the schema's source of truth: the entrypoint runs `prisma migrate deploy` against them, so
# excluding them leaves the deployed database without a schema (REQ-INIT-01) and removes the
# directory a reviewer opens first under "database initialization".
