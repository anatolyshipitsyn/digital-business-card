# Every variable here is optional. docker-compose.yml defaults all of them, so a clean clone starts
# with `docker compose up` and nothing else. Copy this file to .env only to override something
# locally; the filled-in copy is never committed. Production does not read a file at all — it takes
# the same names from the GitHub environment, and docker-compose.prod.yml requires them there.

# Credentials the compose Postgres service initialises itself with. They are read on the first
# start against an empty volume and ignored afterwards, so changing one later means recreating
# the volume. Defaults: card / card / card.
#POSTGRES_USER=
#POSTGRES_PASSWORD=
#POSTGRES_DB=

# The connection string Prisma uses — the application, the container entrypoint and the CLI alike.
# Compose derives it from the three variables above, so set it only if the database moves somewhere
# they cannot describe. The host is the compose service name, not localhost: the database publishes
# no port, and the Prisma CLI runs through the `app` service inside the same network.
#DATABASE_URL=postgresql://USER:PASSWORD@db:5432/DATABASE?schema=public

# Port the HTTP server binds to. Default: 3000.
#PORT=

# Apollo reads this. Under `production` it serves its own landing page instead of Sandbox and
# turns introspection off, so the app opts back in explicitly — see "On serving Sandbox in
# production" in docs/requirements/REQUIREMENTS.md. docker-compose.yml sets `development` because
# it is the development environment; docker-compose.prod.yml sets `production`. Setting it here
# overrides the default docker-compose.yml substitutes.
#NODE_ENV=
