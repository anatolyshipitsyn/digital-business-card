# Copy to .env and fill in. Never commit the filled-in file.

# Postgres connection string used by Prisma, both by the app and by `prisma migrate deploy`.
# Locally this points at the compose service (host `db`); when deployed, at the managed database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Credentials the compose Postgres service initialises itself with. They must agree with the
# user, password and database spelled out in DATABASE_URL above — compose does not derive one
# from the other.
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DATABASE

# Port the HTTP server binds to. Deployment platforms usually inject this.
PORT=3000

# Apollo reads this. Under `production` it serves its own landing page instead of Sandbox and
# turns introspection off, so the app opts back in explicitly — see "On serving Sandbox in
# production" in docs/requirements/REQUIREMENTS.md. Leave unset locally.
NODE_ENV=development
